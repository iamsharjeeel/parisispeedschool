# Node 24; all values below are optional for a non-public review deployment.
# Set server-only variables in Vercel Project Settings > Environment Variables.
# Never prefix credentials with NEXT_PUBLIC_. Never commit .env.local.
SITE_URL=
SITE_PUBLIC=false
# Set this to the supplied LeadConnector webhook URL in Vercel (server-only).
# The real URL is stored only in ignored local configuration, never source code.
CRM_WEBHOOK_URL=
# Existing lowercase crm_webook_url / crm_webhook_url names are also supported.
# This is the only setting required for form delivery. No Redis or signing secret.

# Optional full photographic layout; actual coach portraits are shown independently.
MEDIA_APPROVED=false

# Use GTM OR direct GA4 / Ads IDs; do not install the same tags twice.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=
# Google tags respect the visitor’s analytics consent. No contact details are sent to tags.
